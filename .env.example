# Copy to .env (never commit it). Real environment variables override this file.

# ── who the voice agent calls for ───────────────────────────────────────────
OWNER_NAME="Alex Rivera"            # it opens: "an AI assistant calling on behalf of Alex Rivera"
OWNER_TZ=America/Chicago            # IANA zone; the 08:00-20:00 calling window uses it

# ── the desk ────────────────────────────────────────────────────────────────
PHONE_DESK_STATE_DIR=~/.phone-desk  # requests, tokens, ledger, transcripts, kill switch
PHONE_DESK_APPROVER=terminal        # terminal (local testing) | loopmessage (a 👍 in iMessage)
# PHONE_DESK_WINDOW_START=8
# PHONE_DESK_WINDOW_END=20
# PHONE_DESK_DAILY_CAP=10
# PHONE_DESK_EXTERNAL_DAILY_CAP=3

# ── Vapi (the voice agent and the phone line) ───────────────────────────────
VAPI_API_KEY=
VAPI_PHONE_NUMBER_ID=               # the id of your Vapi outbound number, not the digits
# VAPI_MODEL_PROVIDER=openai        # the model Vapi runs the conversation on
# VAPI_MODEL=gpt-4.1
# VAPI_VOICE_PROVIDER=vapi
# VAPI_VOICE_ID=Elliot

# ── LoopMessage (only with PHONE_DESK_APPROVER=loopmessage) ─────────────────
LOOPMESSAGE_API_KEY=
LOOPMESSAGE_SENDER_NAME=            # your LoopMessage sender
LOOPMESSAGE_OWNER_CONTACT=          # the owner's phone (E.164) or iMessage email: the ONLY approver
LOOPMESSAGE_WEBHOOK_SECRET=         # the Authorization value you set for webhooks in the dashboard

# ── an external agent (optional) ────────────────────────────────────────────
EXTERNAL_AGENT_NAME=Instinct        # shown on its bubbles: "(Instinct asked for this)"
EXTERNAL_AGENT_CONTACT=             # its phone/handle; inbound messages from it are parsed as requests

# ── text rehearsal (optional; pip install anthropic) ────────────────────────
# ANTHROPIC_API_KEY=
# REHEARSAL_MODEL=claude-opus-5
